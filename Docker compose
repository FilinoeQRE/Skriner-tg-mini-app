version: '3.8'

services:
  # ═══════════════════════════════════════════════════════
  #  REDIS — Realtime cache
  # ═══════════════════════════════════════════════════════
  redis:
    image: redis:7-alpine
    container_name: screener_redis
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes --maxmemory 512mb --maxmemory-policy allkeys-lru
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  # ═══════════════════════════════════════════════════════
  #  POSTGRESQL — Persistent storage
  # ═══════════════════════════════════════════════════════
  postgres:
    image: postgres:15-alpine
    container_name: screener_postgres
    environment:
      POSTGRES_DB: density_screener
      POSTGRES_USER: screener
      POSTGRES_PASSWORD: screener_password_change_me
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./schema.sql:/docker-entrypoint-initdb.d/01-schema.sql
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U screener -d density_screener"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ═══════════════════════════════════════════════════════
  #  PGADMIN — Database management UI (optional)
  # ═══════════════════════════════════════════════════════
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: screener_pgadmin
    environment:
      PGADMIN_DEFAULT_EMAIL: admin@screener.local
      PGADMIN_DEFAULT_PASSWORD: admin
      PGADMIN_CONFIG_SERVER_MODE: 'False'
    ports:
      - "5050:80"
    volumes:
      - pgadmin_data:/var/lib/pgadmin
    depends_on:
      - postgres
    restart: unless-stopped
    profiles:
      - tools

  # ═══════════════════════════════════════════════════════
  #  REDIS COMMANDER — Redis UI (optional)
  # ═══════════════════════════════════════════════════════
  redis-commander:
    image: rediscommander/redis-commander:latest
    container_name: screener_redis_ui
    environment:
      - REDIS_HOSTS=local:redis:6379
    ports:
      - "8081:8081"
    depends_on:
      - redis
    restart: unless-stopped
    profiles:
      - tools

volumes:
  redis_data:
    driver: local
  postgres_data:
    driver: local
  pgadmin_data:
    driver: local

networks:
  default:
    name: screener_network
