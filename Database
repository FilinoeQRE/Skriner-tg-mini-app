"""
Database operations manager
Handles PostgreSQL and Redis connections
"""

import json
import logging
from contextlib import asynccontextmanager
from datetime import datetime
from decimal import Decimal
from typing import Optional, List, Dict, Any

import redis.asyncio as redis
from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker
from sqlalchemy import select, update, delete, and_, or_, func
from sqlalchemy.dialects.postgresql import insert

from config import settings
from models import Base, Density, DensityEvent, SymbolStats, Threshold

log = logging.getLogger(__name__)


class DatabaseManager:
    """Manages PostgreSQL and Redis connections"""
    
    def __init__(self):
        # PostgreSQL
        self.engine = create_async_engine(
            settings.postgres_url,
            echo=False,
            pool_size=10,
            max_overflow=20,
            pool_pre_ping=True
        )
        self.async_session = async_sessionmaker(
            self.engine,
            class_=AsyncSession,
            expire_on_commit=False
        )
        
        # Redis
        self.redis: Optional[redis.Redis] = None
    
    async def init_redis(self):
        """Initialize Redis connection"""
        self.redis = redis.Redis(
            host=settings.redis_host,
            port=settings.redis_port,
            db=settings.redis_db,
            password=settings.redis_password,
            decode_responses=True,
            socket_connect_timeout=5,
            socket_keepalive=True
        )
        try:
            await self.redis.ping()
            log.info(f"✅ Redis connected: {settings.redis_host}:{settings.redis_port}")
        except Exception as e:
            log.error(f"❌ Redis connection failed: {e}")
            raise
    
    async def init_db(self):
        """Initialize database schema"""
        try:
            async with self.engine.begin() as conn:
                await conn.run_sync(Base.metadata.create_all)
            log.info("✅ PostgreSQL schema initialized")
        except Exception as e:
            log.error(f"❌ Database initialization failed: {e}")
            raise
    
    async def close(self):
        """Close all connections"""
        if self.redis:
            await self.redis.close()
        await self.engine.dispose()
        log.info("🔌 Database connections closed")
    
    @asynccontextmanager
    async def session(self):
        """Context manager for database sessions"""
        async with self.async_session() as session:
            try:
                yield session
                await session.commit()
            except Exception as e:
                await session.rollback()
                log.error(f"Database session error: {e}")
                raise
    
    # ═══════════════════════════════════════════════════════
    #  REDIS OPERATIONS
    # ═══════════════════════════════════════════════════════
    
    async def cache_density(self, exchange: str, symbol: str, side: str, 
                           price: float, data: dict, ttl: int = 300):
        """Cache density in Redis with TTL"""
        key = f"density:{exchange}:{symbol}:{side}:{price}"
        await self.redis.setex(key, ttl, json.dumps(data))
    
    async def get_cached_density(self, exchange: str, symbol: str, 
                                 side: str, price: float) -> Optional[dict]:
        """Get cached density from Redis"""
        key = f"density:{exchange}:{symbol}:{side}:{price}"
        data = await self.redis.get(key)
        return json.loads(data) if data else None
    
    async def get_active_densities_cached(self, exchange: str = "*", 
                                         max_distance: float = 0.05) -> List[dict]:
        """Get all active densities from Redis cache"""
        pattern = f"density:{exchange}:*"
        keys = await self.redis.keys(pattern)
        
        densities = []
        for key in keys:
            data = await self.redis.get(key)
            if data:
                d = json.loads(data)
                if d.get('distance_pct', 1.0) <= max_distance:
                    densities.append(d)
        
        return sorted(densities, key=lambda x: x.get('notional', 0), reverse=True)
    
    async def cache_price(self, symbol: str, price: float):
        """Cache current price"""
        await self.redis.setex(f"price:{symbol}", 60, str(price))
    
    async def get_cached_price(self, symbol: str) -> Optional[float]:
        """Get cached price"""
        price = await self.redis.get(f"price:{symbol}")
        return float(price) if price else None
    
    async def add_to_active_symbols(self, exchange: str, symbol: str):
        """Add symbol to active symbols set"""
        await self.redis.sadd(f"active_symbols:{exchange}", symbol)
        await self.redis.expire(f"active_symbols:{exchange}", 300)
    
    async def get_active_symbols(self, exchange: str) -> List[str]:
        """Get all active symbols for exchange"""
        return list(await self.redis.smembers(f"active_symbols:{exchange}"))
    
    # ═══════════════════════════════════════════════════════
    #  POSTGRESQL OPERATIONS — DENSITIES
    # ═══════════════════════════════════════════════════════
    
    async def upsert_density(self, exchange: str, symbol: str, side: str,
                            price: float, notional: float, current_price: float,
                            distance_pct: float) -> Density:
        """Insert or update density"""
        async with self.session() as session:
            stmt = insert(Density).values(
                exchange=exchange,
                symbol=symbol,
                side=side,
                price=Decimal(str(price)),
                notional=Decimal(str(notional)),
                current_price=Decimal(str(current_price)),
                distance_pct=Decimal(str(distance_pct)),
                is_active=True
            ).on_conflict_do_update(
                index_elements=['exchange', 'symbol', 'side', 'price'],
                set_={
                    'notional': Decimal(str(notional)),
                    'current_price': Decimal(str(current_price)),
                    'distance_pct': Decimal(str(distance_pct)),
                    'last_updated': func.now(),
                    'is_active': True
                }
            ).returning(Density)
            
            result = await session.execute(stmt)
            density = result.scalar_one()
            await session.commit()
            return density
    
    async def get_active_densities(self, exchange: Optional[str] = None,
                                   symbol: Optional[str] = None,
                                   max_distance: float = 0.05,
                                   limit: int = 100) -> List[Density]:
        """Get active densities from database"""
        async with self.session() as session:
            stmt = select(Density).where(
                Density.is_active == True,
                Density.distance_pct <= max_distance
            )
            
            if exchange:
                stmt = stmt.where(Density.exchange == exchange)
            if symbol:
                stmt = stmt.where(Density.symbol == symbol)
            
            stmt = stmt.order_by(Density.notional.desc()).limit(limit)
            
            result = await session.execute(stmt)
            return list(result.scalars().all())
    
    async def mark_density_inactive(self, exchange: str, symbol: str, 
                                   side: str, price: float):
        """Mark density as inactive (disappeared)"""
        async with self.session() as session:
            stmt = update(Density).where(
                and_(
                    Density.exchange == exchange,
                    Density.symbol == symbol,
                    Density.side == side,
                    Density.price == Decimal(str(price))
                )
            ).values(is_active=False)
            
            await session.execute(stmt)
            await session.commit()
    
    async def cleanup_stale_densities(self, exchange: str, symbol: str, 
                                     seen_keys: set):
        """Mark densities not in seen_keys as inactive"""
        async with self.session() as session:
            # Get all active densities for this symbol
            stmt = select(Density).where(
                and_(
                    Density.exchange == exchange,
                    Density.symbol == symbol,
                    Density.is_active == True
                )
            )
            result = await session.execute(stmt)
            densities = result.scalars().all()
            
            for density in densities:
                key = (symbol, round(float(density.price), 8), density.side)
                if key not in seen_keys:
                    density.is_active = False
            
            await session.commit()
    
    # ═══════════════════════════════════════════════════════
    #  POSTGRESQL OPERATIONS — EVENTS
    # ═══════════════════════════════════════════════════════
    
    async def log_event(self, density_id: int, event_type: str,
                       price_at_event: Optional[float] = None,
                       distance_pct: Optional[float] = None,
                       notional: Optional[float] = None,
                       metadata: Optional[dict] = None):
        """Log density event"""
        async with self.session() as session:
            event = DensityEvent(
                density_id=density_id,
                event_type=event_type,
                price_at_event=Decimal(str(price_at_event)) if price_at_event else None,
                distance_pct_at_event=Decimal(str(distance_pct)) if distance_pct else None,
                notional_at_event=Decimal(str(notional)) if notional else None,
                metadata=metadata
            )
            session.add(event)
            await session.commit()
            return event
    
    async def get_recent_events(self, hours: int = 24, 
                               event_type: Optional[str] = None,
                               limit: int = 100) -> List[DensityEvent]:
        """Get recent events"""
        async with self.session() as session:
            stmt = select(DensityEvent).where(
                DensityEvent.created_at >= func.now() - func.make_interval(0, 0, 0, 0, hours)
            )
            
            if event_type:
                stmt = stmt.where(DensityEvent.event_type == event_type)
            
            stmt = stmt.order_by(DensityEvent.created_at.desc()).limit(limit)
            
            result = await session.execute(stmt)
            return list(result.scalars().all())
    
    # ═══════════════════════════════════════════════════════
    #  POSTGRESQL OPERATIONS — THRESHOLDS
    # ═══════════════════════════════════════════════════════
    
    async def get_thresholds(self, exchange: str = "binance") -> Dict[str, float]:
        """Get all thresholds for exchange"""
        async with self.session() as session:
            stmt = select(Threshold).where(Threshold.exchange == exchange)
            result = await session.execute(stmt)
            thresholds = result.scalars().all()
            
            return {t.symbol: float(t.threshold_usd) for t in thresholds}
    
    async def set_threshold(self, exchange: str, symbol: str, threshold_usd: float):
        """Set or update threshold"""
        async with self.session() as session:
            stmt = insert(Threshold).values(
                exchange=exchange,
                symbol=symbol,
                threshold_usd=Decimal(str(threshold_usd))
            ).on_conflict_do_update(
                index_elements=['exchange', 'symbol'],
                set_={'threshold_usd': Decimal(str(threshold_usd)), 'updated_at': func.now()}
            )
            await session.execute(stmt)
            await session.commit()
    
    # ═══════════════════════════════════════════════════════
    #  POSTGRESQL OPERATIONS — STATS
    # ═══════════════════════════════════════════════════════
    
    async def update_symbol_stats(self, exchange: str, symbol: str):
        """Update aggregated stats for symbol"""
        async with self.session() as session:
            # Calculate stats
            stmt = select(
                func.count(Density.id).label('total'),
                func.avg(Density.notional).label('avg_size'),
                func.max(Density.notional).label('max_size')
            ).where(
                and_(
                    Density.exchange == exchange,
                    Density.symbol == symbol,
                    Density.is_active == True
                )
            )
            
            result = await session.execute(stmt)
            stats = result.one()
            
            # Upsert stats
            upsert_stmt = insert(SymbolStats).values(
                exchange=exchange,
                symbol=symbol,
                total_densities=stats.total,
                avg_density_size=stats.avg_size,
                largest_density=stats.max_size,
                last_scan=func.now()
            ).on_conflict_do_update(
                index_elements=['exchange', 'symbol'],
                set_={
                    'total_densities': stats.total,
                    'avg_density_size': stats.avg_size,
                    'largest_density': stats.max_size,
                    'last_scan': func.now()
                }
            )
            
            await session.execute(upsert_stmt)
            await session.commit()


# Global instance
db = DatabaseManager()
