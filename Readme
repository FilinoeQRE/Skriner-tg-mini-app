## 📱 Telegram Mini App Integration

### Step 1: Register Mini App

1. Talk to @BotFather
2. Send `/newapp`
3. Select your bot
4. Enter app name, description, photo
5. Enter Web App URL: `https://your-domain.com/miniapp`

### Step 2: Add Button to Bot

```python
from telegram import InlineKeyboardButton, InlineKeyboardMarkup, WebAppInfo

keyboard = [[
    InlineKeyboardButton(
        "🔍 Открыть скринер",
        web_app=WebAppInfo(url="https://your-domain.com/miniapp")
    )
]]
reply_markup = InlineKeyboardMarkup(keyboard)

await bot.send_message(
    chat_id=chat_id,
    text="Нажмите кнопку для запуска скринера:",
    reply_markup=reply_markup
)
```

### Step 3: Frontend Integration

```javascript
// Initialize Telegram WebApp
const tg = window.Telegram.WebApp;
tg.ready();

// Get user info
const userId = tg.initDataUnsafe.user.id;
const username = tg.initDataUnsafe.user.username;

// Connect to WebSocket
const ws = new WebSocket('wss://your-api.com/ws/densities');

ws.onmessage = (event) => {
  const data = JSON.parse(event.data);
  updateTable(data);
};

// Fetch initial data
fetch('https://your-api.com/api/densities?limit=50')
  .then(res => res.json())
  .then(data => renderTable(data));
```

### Frontend Example (React)

```jsx
import { useEffect, useState } from 'react';

function DensityTable() {
  const [densities, setDensities] = useState([]);

  useEffect(() => {
    const ws = new WebSocket('ws://localhost:8000/ws/densities');
    
    ws.onmessage = (event) => {
      const msg = JSON.parse(event.data);
      if (msg.type === 'snapshot') {
        setDensities(msg.data);
      } else if (msg.type === 'new') {
        setDensities(prev => [msg.data, ...prev]);
      }
    };

    return () => ws.close();
  }, []);

  return (
    <table>
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Side</th>
          <th>Price</th>
          <th>Size</th>
          <th>Distance</th>
        </tr>
      </thead>
      <tbody>
        {densities.map(d => (
          <tr key={d.id}>
            <td>{d.symbol}</td>
            <td>{d.side_emoji}</td>
            <td>{d.price.toFixed(4)}</td>
            <td>${(d.notional / 1000000).toFixed(2)}M</td>
            <td>{(d.distance_pct * 100).toFixed(2)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  );
}
```

