-- ═══════════════════════════════════════════════════════
-- POSTGRESQL SCHEMA — Density Screener
-- ═══════════════════════════════════════════════════════

-- 1. Плотности (актуальное состояние)
CREATE TABLE IF NOT EXISTS densities (
    id SERIAL PRIMARY KEY,
    exchange VARCHAR(20) NOT NULL,
    symbol VARCHAR(20) NOT NULL,
    side VARCHAR(4) NOT NULL CHECK (side IN ('bids', 'asks')),
    price DECIMAL(20, 8) NOT NULL,
    notional DECIMAL(20, 2) NOT NULL,
    current_price DECIMAL(20, 8) NOT NULL,
    distance_pct DECIMAL(8, 6) NOT NULL,
    first_seen TIMESTAMP NOT NULL DEFAULT NOW(),
    last_updated TIMESTAMP NOT NULL DEFAULT NOW(),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    
    UNIQUE(exchange, symbol, side, price)
);

CREATE INDEX idx_densities_active ON densities(exchange, symbol, is_active);
CREATE INDEX idx_densities_distance ON densities(distance_pct) WHERE is_active = TRUE;
CREATE INDEX idx_densities_symbol ON densities(symbol) WHERE is_active = TRUE;

-- 2. События плотностей (история)
CREATE TABLE IF NOT EXISTS density_events (
    id SERIAL PRIMARY KEY,
    density_id INTEGER REFERENCES densities(id) ON DELETE CASCADE,
    event_type VARCHAR(20) NOT NULL CHECK (event_type IN (
        'detected',    -- найдена новая плотность
        'approached',  -- цена приблизилась (< 1%)
        'touched',     -- цена коснулась уровня
        'disappeared', -- плотность исчезла
        'broken'       -- цена пробила уровень
    )),
    price_at_event DECIMAL(20, 8),
    distance_pct_at_event DECIMAL(8, 6),
    notional_at_event DECIMAL(20, 2),
    metadata JSONB,
    created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_events_density ON density_events(density_id);
CREATE INDEX idx_events_type ON density_events(event_type, created_at DESC);
CREATE INDEX idx_events_time ON density_events(created_at DESC);

-- 3. Статистика по символам (агрегированные данные)
CREATE TABLE IF NOT EXISTS symbol_stats (
    id SERIAL PRIMARY KEY,
    exchange VARCHAR(20) NOT NULL,
    symbol VARCHAR(20) NOT NULL,
    total_densities INTEGER NOT NULL DEFAULT 0,
    avg_density_size DECIMAL(20, 2),
    largest_density DECIMAL(20, 2),
    detected_count INTEGER NOT NULL DEFAULT 0,
    touched_count INTEGER NOT NULL DEFAULT 0,
    broken_count INTEGER NOT NULL DEFAULT 0,
    last_scan TIMESTAMP NOT NULL DEFAULT NOW(),
    
    UNIQUE(exchange, symbol)
);

CREATE INDEX idx_symbol_stats_lookup ON symbol_stats(exchange, symbol);

-- 4. Конфигурация порогов (кастомные пороги для символов)
CREATE TABLE IF NOT EXISTS thresholds (
    id SERIAL PRIMARY KEY,
    exchange VARCHAR(20) NOT NULL,
    symbol VARCHAR(20) NOT NULL,
    threshold_usd DECIMAL(20, 2) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    UNIQUE(exchange, symbol)
);

-- 5. Пользователи (для будущей авторизации через Telegram)
CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    telegram_id BIGINT NOT NULL UNIQUE,
    username VARCHAR(100),
    first_name VARCHAR(100),
    last_name VARCHAR(100),
    language_code VARCHAR(10),
    is_premium BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    last_active TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_users_telegram ON users(telegram_id);

-- 6. Подписки пользователей (watchlist)
CREATE TABLE IF NOT EXISTS user_watchlist (
    id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
    exchange VARCHAR(20) NOT NULL,
    symbol VARCHAR(20) NOT NULL,
    notify_on_approach BOOLEAN NOT NULL DEFAULT TRUE,
    notify_on_touch BOOLEAN NOT NULL DEFAULT TRUE,
    custom_threshold DECIMAL(20, 2),
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    UNIQUE(user_id, exchange, symbol)
);

CREATE INDEX idx_watchlist_user ON user_watchlist(user_id);

