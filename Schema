-- ФУНКЦИИ И ТРИГГЕРЫ
-- ═══════════════════════════════════════════════════════

-- Автоматическое обновление last_updated
CREATE OR REPLACE FUNCTION update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.last_updated = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER update_densities_modtime
    BEFORE UPDATE ON densities
    FOR EACH ROW
    EXECUTE FUNCTION update_modified_column();

-- Автоматическое логирование событий при изменении статуса
CREATE OR REPLACE FUNCTION log_density_status_change()
RETURNS TRIGGER AS $$
BEGIN
    IF (OLD.is_active = TRUE AND NEW.is_active = FALSE) THEN
        INSERT INTO density_events (density_id, event_type, price_at_event, distance_pct_at_event, notional_at_event)
        VALUES (NEW.id, 'disappeared', NEW.current_price, NEW.distance_pct, NEW.notional);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_density_status
    AFTER UPDATE ON densities
    FOR EACH ROW
    WHEN (OLD.is_active IS DISTINCT FROM NEW.is_active)
    EXECUTE FUNCTION log_density_status_change();

-- ═══════════════════════════════════════════════════════
-- ПРЕДСТАВЛЕНИЯ (VIEWS)
-- ═══════════════════════════════════════════════════════

-- Активные плотности с расстоянием < 5%
CREATE OR REPLACE VIEW active_densities_near AS
SELECT 
    d.*,
    CASE 
        WHEN d.side = 'bids' THEN '🟢 BID'
        ELSE '🔴 ASK'
    END as side_emoji,
    EXTRACT(EPOCH FROM (NOW() - d.first_seen)) as age_seconds
FROM densities d
WHERE d.is_active = TRUE 
  AND d.distance_pct <= 0.05
ORDER BY d.distance_pct ASC, d.notional DESC;

-- Топ плотностей по размеру
CREATE OR REPLACE VIEW top_densities AS
SELECT 
    d.*,
    CASE 
        WHEN d.side = 'bids' THEN '🟢 BID'
        ELSE '🔴 ASK'
    END as side_emoji
FROM densities d
WHERE d.is_active = TRUE
ORDER BY d.notional DESC
LIMIT 50;

-- Статистика событий по символам за последние 24 часа
CREATE OR REPLACE VIEW symbol_event_stats_24h AS
SELECT 
    d.exchange,
    d.symbol,
    COUNT(DISTINCT d.id) as total_densities,
    COUNT(CASE WHEN e.event_type = 'touched' THEN 1 END) as touched_count,
    COUNT(CASE WHEN e.event_type = 'broken' THEN 1 END) as broken_count,
    AVG(d.notional) as avg_notional,
    MAX(d.notional) as max_notional
FROM densities d
LEFT JOIN density_events e ON e.density_id = d.id 
    AND e.created_at >= NOW() - INTERVAL '24 hours'
WHERE d.first_seen >= NOW() - INTERVAL '24 hours'
GROUP BY d.exchange, d.symbol
ORDER BY total_densities DESC;

