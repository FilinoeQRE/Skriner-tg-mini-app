@app.get("/api/densities", response_model=List[DensityResponse])
async def get_densities(
    exchange: str = Query(default="binance", description="Exchange name"),
    symbol: Optional[str] = Query(default=None, description="Filter by symbol"),
    max_distance: float = Query(default=0.05, description="Max distance from price (%)"),
    limit: int = Query(default=100, description="Max results")
):
    """Get active densities with filters"""
    try:
        # Try Redis cache first
        cached = await db.get_active_densities_cached(exchange, max_distance)
        if cached and not symbol:
            return cached[:limit]
        
        # Fallback to PostgreSQL
        densities = await db.get_active_densities(exchange, symbol, max_distance, limit)
        return [d.to_dict() for d in densities]
    
    except Exception as e:
        log.error(f"Error fetching densities: {e}")
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/api/densities/top", response_model=List[DensityResponse])
async def get_top_densities(
    exchange: str = Query(default="binance"),
    limit: int = Query(default=10, description="Top N densities")
):
    """Get top densities by notional size"""
    try:
        densities = await db.get_active_densities(
            exchange=exchange,
            max_distance=1.0,  # Get all
            limit=limit
        )
        # Sort by notional descending
        densities.sort(key=lambda d: float(d.notional), reverse=True)
        return [d.to_dict() for d in densities[:limit]]
    
    except Exception as e:
        log.error(f"Error fetching top densities: {e}")
        raise HTTPException(status_code=500, detail=str(e))


